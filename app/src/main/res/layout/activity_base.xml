<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- BACK BUTTON -->
    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/purple_bg"
        android:elevation="6dp"
        android:padding="13dp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- CONTENT AREA -->
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBarCard"/>

    <!-- FLOATING BOTTOM BAR -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomBarCard"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:elevation="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- HOME TAB -->
            <LinearLayout
                android:id="@+id/homeBtnLayout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <View
                    android:id="@+id/homeIndicator"
                    android:layout_width="28dp"
                    android:layout_height="3dp"
                    android:background="@drawable/purple_bg"
                    android:visibility="invisible"/>

                <ImageView
                    android:id="@+id/homeBtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/ic_home"/>

                <TextView
                    android:id="@+id/homeLabelTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="10sp"
                    android:textColor="#888888"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp"/>

            </LinearLayout>

            <!-- EXPLORER TAB (provider) -->
            <LinearLayout
                android:id="@+id/explorerBtnLayout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <View
                    android:id="@+id/explorerIndicator"
                    android:layout_width="28dp"
                    android:layout_height="3dp"
                    android:background="@drawable/purple_bg"
                    android:visibility="invisible"/>

                <ImageView
                    android:id="@+id/explorerBtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/ic_addbtn"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Services"
                    android:textSize="10sp"
                    android:textColor="#888888"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp"/>

            </LinearLayout>

            <!-- BOOKMARK TAB (user) -->
            <LinearLayout
                android:id="@+id/bookmarkBtnLayout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <View
                    android:id="@+id/bookmarkIndicator"
                    android:layout_width="28dp"
                    android:layout_height="3dp"
                    android:background="@drawable/purple_bg"
                    android:visibility="invisible"/>

                <ImageView
                    android:id="@+id/bookmarkBtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/ic_bookmark"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saved"
                    android:textSize="10sp"
                    android:textColor="#888888"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp"/>

            </LinearLayout>

            <!-- ADMIN TAB -->
            <LinearLayout
                android:id="@+id/adminBtnLayout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <View
                    android:id="@+id/adminIndicator"
                    android:layout_width="28dp"
                    android:layout_height="3dp"
                    android:background="@drawable/purple_bg"
                    android:visibility="invisible"/>

                <ImageView
                    android:id="@+id/adminBtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/ic_edit"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage"
                    android:textSize="10sp"
                    android:textColor="#888888"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp"/>

            </LinearLayout>

            <!-- PROFILE TAB -->
            <LinearLayout
                android:id="@+id/profileBtnLayout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <View
                    android:id="@+id/profileIndicator"
                    android:layout_width="28dp"
                    android:layout_height="3dp"
                    android:background="@drawable/purple_bg"
                    android:visibility="invisible"/>

                <ImageView
                    android:id="@+id/profileBtn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/ic_profile"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textSize="10sp"
                    android:textColor="#888888"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp"/>

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>