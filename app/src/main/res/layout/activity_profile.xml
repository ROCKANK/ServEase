<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/blue"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profilePic"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:scaleType="centerCrop"
                android:elevation="4dp"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/circleImage"
                app:strokeColor="@color/white"
                app:strokeWidth="3dp"/>

            <TextView
                android:id="@+id/profileInitialTxt"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/circle_bg"
                android:elevation="4dp"
                android:visibility="visible"/>

            <ImageView
                android:id="@+id/changePicBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="80dp"
                android:background="@drawable/purple_bg"
                android:padding="7dp"
                android:elevation="8dp"
                android:src="@drawable/ic_camera"/>

        </FrameLayout>

        <TextView
            android:id="@+id/displayNameTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:text="Your Name"/>

        <TextView
            android:id="@+id/roleTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:background="@drawable/purple_bg"
            android:paddingHorizontal="20dp"
            android:paddingVertical="5dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="User"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:background="#E0E0E0"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDIT NAME"
                android:textSize="11sp"
                android:textColor="#888888"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/nameEdt"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter your name"
                android:paddingHorizontal="16dp"
                android:textSize="15sp"
                android:textColor="@color/black"
                android:background="@drawable/gradient_bg2"
                android:elevation="2dp"/>

            <Button
                android:id="@+id/updateBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Update Profile"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:backgroundTint="#6650A4"
                android:layout_marginTop="16dp"/>

            <Button
                android:id="@+id/helpBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Help / Report a Problem"
                android:textColor="@color/white"
                android:backgroundTint="#FF9800"
                android:layout_marginTop="8dp"/>

            <Button
                android:id="@+id/logoutBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Logout"
                android:textStyle="bold"
                android:textColor="#6650A4"
                android:textSize="15sp"
                android:backgroundTint="@android:color/transparent"
                android:layout_marginTop="4dp"/>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>